# Frontend (build-time)
# In production the frontend on Vercel points at the API on Render.
# Locally leave this unset — Vite proxies /api and /uploads to localhost:3001.
VITE_API_ORIGIN=https://experience-rishikesh-api.onrender.com

# Backend (runtime — set these on Render, not in git)
ADMIN_PASSWORD=change-me-to-a-strong-secret
CORS_ORIGIN=https://experience-rishikesh.vercel.app
PORT=10000
PERSIST_DIR=/opt/render/project/src/persist
